# 复制为 .env.local（本地开发）或填到 Vercel 的 Environment Variables（线上）

# Claude API Key，在 https://console.anthropic.com 创建
ANTHROPIC_API_KEY=

# 用于签名登录状态的随机字符串（至少 32 位），可以用 `openssl rand -hex 32` 生成
SESSION_SECRET=

# 注册邀请码：知道邀请码的人才能注册，自己和家人用
INVITE_CODE=

# 数据库。本地开发留空即使用项目目录下的 local.db；线上填 Turso 的地址和 Token
# （在 Vercel 里通过 Storage 添加 Turso 时会自动设置 TURSO_DATABASE_URL / TURSO_AUTH_TOKEN，这两项就不用填）
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# 可选：识别用的模型，默认 claude-opus-5-5
# ANTHROPIC_MODEL=

# 可选：本地开发设为 1 时不调用 API，返回演示数据
# RECOGNIZE_MOCK=1
